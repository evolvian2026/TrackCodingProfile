# ---------------------------------------------------------------------------
# Copy to .env and adjust. Every value below has a working default for local
# development; the ones marked REQUIRED must be changed before production.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Database ------------------------------------------------------------------
DATABASE_URL=postgresql://tcp:tcp@localhost:5432/tcp?schema=public

# Auth (REQUIRED in production) ---------------------------------------------
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Web -----------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173
# Where students reach the app, used to build their read-only view links.
# Defaults to the first CORS_ORIGIN, which is right for a single-origin deploy.
APP_BASE_URL=
TRUST_PROXY=false

# Background processing ------------------------------------------------------
# redis  -> BullMQ queue, survives restarts, scales to multiple workers
# inline -> in-process queue, zero infrastructure, good for local development
QUEUE_DRIVER=inline
REDIS_URL=redis://localhost:6379
QUEUE_CONCURRENCY=4
# Run the worker inside the API process (set false when running a separate worker)
RUN_WORKER_IN_API=true

# Platform data --------------------------------------------------------------
# mock -> deterministic sample responses, never touches the internet
# live -> real platform APIs / public endpoints
DATA_SOURCE=mock
CACHE_TTL_MINUTES=720
HTTP_TIMEOUT_MS=15000
MAX_RETRIES=3

# Uploads --------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
MAX_UPLOAD_ROWS=20000

# API rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Seeding --------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@tracker.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_STUDENT_COUNT=24

# Frontend (Vite) ------------------------------------------------------------
VITE_API_URL=http://localhost:4000

# Docker Compose only --------------------------------------------------------
# Used by docker-compose.yml; ignored when running the app directly.
POSTGRES_USER=tcp
POSTGRES_PASSWORD=tcp
POSTGRES_DB=tcp
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=4000
WEB_PORT=8080
