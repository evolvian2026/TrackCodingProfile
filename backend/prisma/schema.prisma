// Competitive Programming Student Performance Tracker — data model
// See docs/ARCHITECTURE.md for the reasoning behind this schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  TRAINER
  VIEWER
}

enum Platform {
  LEETCODE
  CODECHEF
  HACKERRANK
  CODEFORCES
}

/// Why a piece of data is (or is not) present. `0` and `unknown` are never
/// conflated: a metric is only a number when the platform actually reported it.
enum DataStatus {
  PENDING
  AVAILABLE
  NOT_FOUND
  PRIVATE
  UNAVAILABLE
  ERROR
  RATE_LIMITED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  UNKNOWN
}

enum JobType {
  UPLOAD_IMPORT
  REFRESH_SELECTED
  REFRESH_BATCH
  REFRESH_ALL
  REFRESH_PLATFORM
  RETRY_FAILED
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum JobItemStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  RATE_LIMITED
  SKIPPED
}

enum SkillLevel {
  NONE
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

/// Why a student is on the "needs attention" list.
enum AlertType {
  /// Solved count has not moved across the whole observation window.
  NO_PROGRESS
  /// Current rating is well below its recent peak.
  RATING_DECLINE
  /// Has not entered a contest across the observation window.
  CONTEST_INACTIVE
  /// Handles exist but no platform has ever returned data.
  NO_DATA
  /// A linked handle looks wrong — not found, private or erroring.
  PROFILE_UNAVAILABLE
  /// No handles on file, so nothing will ever be fetched.
  NO_PLATFORM_HANDLES
  /// We have not refreshed recently enough to judge activity at all.
  /// This is an administrator problem, never the student's.
  STALE_DATA
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum ScheduledRunStatus {
  CLAIMED
  STARTED
  COMPLETED
  FAILED
  SKIPPED
}

/// What a goal measures. Every one of these maps to a column the analytics
/// layer already records, and to a flag saying whether it was knowable — a
/// target on a metric a student's platforms do not publish is unmeasurable for
/// that student, not failed.
enum GoalMetric {
  PROBLEMS_SOLVED
  CONTESTS_ATTENDED
  CP_SCORE
  CONTEST_RATING
  TOPICS_COVERED
}

/// How a refresh run was started. Kept apart from the note, because the note is
/// overwritten with the outcome once the job finishes and "somebody pressed the
/// button" has to survive that.
enum RunTrigger {
  SCHEDULED
  MANUAL
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(VIEWER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  uploads            UploadBatch[]
  processingJobs     ProcessingJob[]
  refreshTokens      RefreshToken[]
  acknowledgedAlerts StudentAlert[]
  goals              Goal[]
  shareLinks         StudentShareLink[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Students
// ---------------------------------------------------------------------------

model Student {
  id         String   @id @default(cuid())
  /// Institution-issued identifier from the uploaded spreadsheet.
  studentId  String   @unique
  name       String
  email      String?
  phone      String?
  university String?
  college    String?
  batch      String?
  branch     String?
  section    String?
  isActive   Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  profiles       PlatformProfile[]
  solvedProblems StudentProblem[]
  topics         StudentTopic[]
  contestResults ContestResult[]
  ratingHistory  RatingHistory[]
  snapshots      DataSnapshot[]
  jobItems       ProcessingJobItem[]
  errors         PlatformError[]
  analytics      StudentAnalytics?
  skills         StudentSkill[]
  alerts         StudentAlert[]
  shareLink      StudentShareLink?

  @@index([college])
  @@index([batch])
  @@index([branch])
  @@index([section])
  @@index([university])
  @@index([name])
  @@index([email])
  @@map("students")
}

// ---------------------------------------------------------------------------
// Platform profiles (normalized across all four platforms)
// ---------------------------------------------------------------------------

model PlatformProfile {
  id         String   @id @default(cuid())
  studentId  String
  platform   Platform
  username   String
  profileUrl String?

  status          DataStatus @default(PENDING)
  statusMessage   String?
  lastFetchedAt   DateTime?
  lastSuccessAt   DateTime?
  fetchDurationMs Int?

  // Identity ---------------------------------------------------------------
  displayName String?
  country     String?
  avatarUrl   String?

  // Rating / ranking -------------------------------------------------------
  rating       Int?
  maxRating    Int?
  rankTitle    String?
  maxRankTitle String?
  globalRank   Int?
  countryRank  Int?
  stars        String?
  reputation   Int?
  contribution Int?
  friendCount  Int?

  // Problem counts ---------------------------------------------------------
  totalSolved         Int?
  easySolved          Int?
  mediumSolved        Int?
  hardSolved          Int?
  problemsAttempted   Int?
  totalSubmissions    Int?
  acceptedSubmissions Int?
  acceptanceRate      Float?

  // Contests ---------------------------------------------------------------
  contestsAttended     Int?
  contestRating        Int?
  contestGlobalRanking Int?
  contestTopPercentage Float?

  // Platform specific, kept as JSON so adapters can evolve independently ----
  problemSolvingScore Float?
  badges              Json?
  certificates        Json?
  skills              Json?
  domains             Json?
  raw                 Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, platform])
  @@index([platform, status])
  @@index([platform, username])
  @@index([rating])
  @@index([totalSolved])
  @@map("platform_profiles")
}

// ---------------------------------------------------------------------------
// Problems / topics
// ---------------------------------------------------------------------------

model Problem {
  id         String     @id @default(cuid())
  platform   Platform
  externalId String
  name       String
  url        String?
  difficulty Difficulty @default(UNKNOWN)
  /// Platform-native rating for the problem where one exists (e.g. Codeforces).
  points     Int?
  createdAt  DateTime   @default(now())

  topics        ProblemTopic[]
  studentSolves StudentProblem[]

  @@unique([platform, externalId])
  @@index([platform, difficulty])
  @@map("problems")
}

model Topic {
  id   String @id @default(cuid())
  /// Canonical topic name after normalization (e.g. "Dynamic Programming").
  name String @unique
  slug String @unique

  problems ProblemTopic[]

  @@map("topics")
}

model ProblemTopic {
  problemId String
  topicId   String

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([problemId, topicId])
  @@index([topicId])
  @@map("problem_topics")
}

model StudentProblem {
  id        String    @id @default(cuid())
  studentId String
  problemId String
  platform  Platform
  solvedAt  DateTime?
  attempts  Int?
  createdAt DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([studentId, problemId])
  @@index([studentId, platform])
  @@index([studentId, solvedAt])
  @@map("student_problems")
}

/// Per-student aggregated topic counts. Platforms usually expose topic totals
/// directly (without a full problem list), so this is stored as its own fact
/// table rather than derived from `student_problems`.
model StudentTopic {
  id             String   @id @default(cuid())
  studentId      String
  platform       Platform
  topic          String
  problemsSolved Int
  updatedAt      DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, platform, topic])
  @@index([topic])
  @@index([studentId])
  @@map("student_topics")
}

// ---------------------------------------------------------------------------
// Contests & ratings
// ---------------------------------------------------------------------------

model Contest {
  id         String    @id @default(cuid())
  platform   Platform
  externalId String
  name       String
  startTime  DateTime?
  url        String?
  createdAt  DateTime  @default(now())

  results ContestResult[]

  @@unique([platform, externalId])
  @@index([platform, startTime])
  @@map("contests")
}

model ContestResult {
  id             String    @id @default(cuid())
  studentId      String
  contestId      String
  platform       Platform
  rank           Int?
  ratingBefore   Int?
  ratingAfter    Int?
  ratingChange   Int?
  problemsSolved Int?
  participatedAt DateTime?
  createdAt      DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([studentId, contestId])
  @@index([studentId, platform])
  @@index([studentId, participatedAt])
  @@map("contest_results")
}

model RatingHistory {
  id          String   @id @default(cuid())
  studentId   String
  platform    Platform
  rating      Int
  recordedAt  DateTime
  /// "contest" when derived from a contest result, "snapshot" when sampled.
  source      String   @default("snapshot")
  contestName String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, platform, recordedAt, source])
  @@index([studentId, platform, recordedAt])
  @@map("rating_history")
}

// ---------------------------------------------------------------------------
// Historical snapshots
// ---------------------------------------------------------------------------

/// Point-in-time copy of a student's headline metrics. Never overwritten, so
/// growth over time can be charted.
model DataSnapshot {
  id         String    @id @default(cuid())
  studentId  String
  /// null = combined/aggregate snapshot across every platform.
  platform   Platform?
  capturedAt DateTime  @default(now())

  totalSolved      Int?
  easySolved       Int?
  mediumSolved     Int?
  hardSolved       Int?
  rating           Int?
  maxRating        Int?
  globalRank       Int?
  contestsAttended Int?
  topicCount       Int?
  cpScore          Float?
  metrics          Json?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, platform, capturedAt])
  @@index([capturedAt])
  @@map("data_snapshots")
}

// ---------------------------------------------------------------------------
// Ingestion & processing
// ---------------------------------------------------------------------------

model UploadBatch {
  id            String   @id @default(cuid())
  originalName  String
  storedPath    String?
  sizeBytes     Int
  sheetName     String?
  totalRows     Int      @default(0)
  validRows     Int      @default(0)
  invalidRows   Int      @default(0)
  duplicateRows Int      @default(0)
  createdCount  Int      @default(0)
  updatedCount  Int      @default(0)
  mapping       Json?
  headers       Json?
  issues        Json?
  status        String   @default("PENDING")
  uploadedById  String?
  createdAt     DateTime @default(now())

  uploadedBy User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  jobs       ProcessingJob[]

  @@index([createdAt])
  @@map("upload_batches")
}

model ProcessingJob {
  id             String     @id @default(cuid())
  /// Human-friendly sequential number shown in the UI ("Job #124").
  number         Int        @unique @default(autoincrement())
  type           JobType
  status         JobStatus  @default(QUEUED)
  platforms      Platform[]
  totalStudents  Int        @default(0)
  totalItems     Int        @default(0)
  processed      Int        @default(0)
  successful     Int        @default(0)
  failed         Int        @default(0)
  rateLimited    Int        @default(0)
  skipped        Int        @default(0)
  currentStudent String?
  forceRefresh   Boolean    @default(false)
  error          String?
  options        Json?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  createdById   String?
  uploadBatchId String?

  createdBy   User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  uploadBatch UploadBatch?        @relation(fields: [uploadBatchId], references: [id], onDelete: SetNull)
  items       ProcessingJobItem[]
  errors      PlatformError[]

  @@index([status, createdAt])
  @@map("processing_jobs")
}

model ProcessingJobItem {
  id         String        @id @default(cuid())
  jobId      String
  studentId  String
  platform   Platform
  status     JobItemStatus @default(PENDING)
  attempts   Int           @default(0)
  lastError  String?
  dataStatus DataStatus?
  startedAt  DateTime?
  finishedAt DateTime?
  durationMs Int?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  job     ProcessingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([jobId, studentId, platform])
  @@index([jobId, status])
  @@index([status])
  @@map("processing_job_items")
}

model PlatformError {
  id         String     @id @default(cuid())
  studentId  String?
  jobId      String?
  platform   Platform
  status     DataStatus
  message    String
  context    Json?
  occurredAt DateTime   @default(now())

  student Student?       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  job     ProcessingJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([platform, occurredAt])
  @@index([studentId])
  @@index([jobId])
  @@map("platform_errors")
}

// ---------------------------------------------------------------------------
// Derived analytics (materialized so leaderboards stay fast at 10k+ students)
// ---------------------------------------------------------------------------

model StudentAnalytics {
  studentId String @id

  totalSolved     Int      @default(0)
  easySolved      Int      @default(0)
  mediumSolved    Int      @default(0)
  hardSolved      Int      @default(0)
  platformsActive Int      @default(0)
  totalContests   Int      @default(0)
  bestRank        Int?
  avgRank         Float?
  bestRating      Int?
  currentRating   Int?
  topicCount      Int      @default(0)
  topicCoverage   Float    @default(0)
  cpScore         Float    @default(0)
  scoreBreakdown  Json?
  /// Set when no platform returned usable data — keeps "unknown" out of rankings.
  hasData         Boolean  @default(false)
  /// Whether ANY platform that returned data actually publishes this metric.
  /// Without these, a student whose only working platform is CodeChef would
  /// show "0 topics" and "0 easy" — asserting a zero we never observed.
  difficultyKnown Boolean  @default(false)
  topicsKnown     Boolean  @default(false)
  contestsKnown   Boolean  @default(false)
  computedAt      DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([cpScore])
  @@index([totalSolved])
  @@index([currentRating])
  @@map("student_analytics")
}

model StudentSkill {
  id             String     @id @default(cuid())
  studentId      String
  topic          String
  level          SkillLevel
  score          Float
  problemsSolved Int
  platformCount  Int        @default(0)
  updatedAt      DateTime   @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, topic])
  @@index([studentId])
  @@map("student_skills")
}

// ---------------------------------------------------------------------------
// Alerts — the "needs attention" list
// ---------------------------------------------------------------------------

/// One active concern about one student.
///
/// Rows are keyed on (student, type) so `detectedAt` answers "how long has this
/// been true", and a concern that stops applying is deleted rather than left to
/// rot. `evidence` always carries the numbers the rule fired on, so a coach can
/// see why without trusting the label.
model StudentAlert {
  id               String        @id @default(cuid())
  studentId        String
  type             AlertType
  severity         AlertSeverity
  message          String
  /// The observations behind the alert (values, dates, window length).
  evidence         Json?
  detectedAt       DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  /// Set when someone has seen it and does not need it in the default view.
  acknowledgedAt   DateTime?
  acknowledgedById String?

  student        Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  acknowledgedBy User?   @relation(fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@unique([studentId, type])
  @@index([type, severity])
  @@index([acknowledgedAt])
  @@map("student_alerts")
}

// ---------------------------------------------------------------------------
// Scheduled refreshes
// ---------------------------------------------------------------------------

/// One occurrence of the refresh schedule.
///
/// `scheduledFor` is unique, which is the whole point: several workers may be
/// running, and inserting the row is how one of them claims the slot. Losing
/// that insert means another worker got there first, so nothing double-fires.
model ScheduledRun {
  id           String             @id @default(cuid())
  scheduledFor DateTime           @unique
  status       ScheduledRunStatus @default(CLAIMED)
  trigger      RunTrigger         @default(SCHEDULED)
  jobId        String?
  /// Why a slot was skipped, or why the run failed.
  note         String?
  claimedAt    DateTime           @default(now())
  finishedAt   DateTime?

  @@index([scheduledFor])
  @@map("scheduled_runs")
}

// ---------------------------------------------------------------------------
// Configuration
// ---------------------------------------------------------------------------

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

/// Response cache for platform fetches, so a refresh of 10k students does not
/// re-hit a platform for data that is still fresh.
model PlatformCache {
  key       String     @id
  platform  Platform
  payload   Json
  status    DataStatus
  fetchedAt DateTime   @default(now())
  expiresAt DateTime

  @@index([platform, expiresAt])
  @@map("platform_cache")
}

// ---------------------------------------------------------------------------
// Goals and shareable student views
// ---------------------------------------------------------------------------

/// A target set for a cohort. Scope fields left null widen the cohort, so a goal
/// with every scope null applies to everyone.
model Goal {
  id          String  @id @default(cuid())
  name        String
  description String?

  university String?
  college    String?
  batch      String?
  branch     String?
  section    String?

  /// Progress is measured against absolute totals, not gains since this date;
  /// startsOn exists so the UI can show how much of the window has elapsed and
  /// so observed pace is measured over the right period.
  startsOn DateTime
  dueOn    DateTime
  isActive Boolean  @default(true)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  targets   GoalTarget[]

  @@index([isActive, dueOn])
  @@index([batch])
  @@index([college])
  @@map("goals")
}

model GoalTarget {
  id     String     @id @default(cuid())
  goalId String
  metric GoalMetric
  /// Float so CP score targets are expressible; whole numbers everywhere else.
  target Float

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, metric])
  @@map("goal_targets")
}

/// A read-only link that lets one student see their own record without an
/// account. The token is stored hashed, exactly like a refresh token, so a
/// database read cannot hand someone a working link.
model StudentShareLink {
  id        String @id @default(cuid())
  studentId String @unique
  tokenHash String @unique

  createdById  String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  revokedAt    DateTime?
  /// Usage, so a coordinator can see whether the links are being opened at all.
  lastViewedAt DateTime?
  viewCount    Int       @default(0)

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([revokedAt])
  @@map("student_share_links")
}
